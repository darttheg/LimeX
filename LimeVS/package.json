{
  "name": "lime-engine",
  "displayName": "Lime Engine",
  "publisher": "Lime",
  "description": "Build and run Lua-driven 3D applications.",
  "icon": "icon.png",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*",
    "onLanguage:lua"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lime.build",
        "title": "Lime: Build",
        "icon": "$(tools)"
      },
      {
        "command": "lime.run",
        "title": "Lime: Run",
        "icon": "$(play)"
      },
      {
        "command": "lime.package",
        "title": "Lime: Package Project",
        "icon": "$(package)"
      },
      {
        "command": "lime.newProject",
        "title": "Lime: Create New Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "lime.selectPlatform",
        "title": "Lime: Select Platform",
        "icon": "$(device-mobile)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lime",
          "title": "Lime",
          "icon": "icon.png"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "lime.build",
          "group": "navigation@1"
        },
        {
          "command": "lime.run",
          "group": "navigation@2"
        },
        {
          "command": "lime.package",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Lime Engine",
      "properties": {
        "lime.android.sdkPath": {
          "type": "string",
          "default": "",
          "description": "Android SDK folder. Empty uses ANDROID_HOME or Android Studio's default location."
        },
        "lime.android.javaHome": {
          "type": "string",
          "default": "",
          "description": "Java folder (JDK). Empty uses JAVA_HOME or Android Studio's bundled one."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "win-version-info": "^6.0.1"
  }
}
